{
  "name": "flotilla",
  "displayName": "Flotilla",
  "version": "1.3.2",
  "description": "Your running subagents and background tasks, live: above the prompt, in a side pane or on one line, with timeline, workflow groups, cost and stuck-agent alerts",
  "author": {
    "name": "aleqsd",
    "url": "https://github.com/aleqsd"
  },
  "homepage": "https://github.com/aleqsd/flotilla",
  "repository": "https://github.com/aleqsd/flotilla",
  "documentationUrl": "https://github.com/Aleqsd/flotilla#readme",
  "supportUrl": "https://github.com/Aleqsd/flotilla/issues",
  "license": "MIT",
  "keywords": [
    "agents",
    "background",
    "cost",
    "dashboard",
    "monitor",
    "subagents",
    "tasks",
    "workflow"
  ],
  "icon": "./assets/icon.png",
  "userConfig": {
    "language": {
      "type": "string",
      "title": "Language",
      "description": "Interface language: auto follows Claude Code's language setting, then your locale",
      "default": "auto",
      "options": [
        "auto",
        "en",
        "fr"
      ]
    }
  },
  "types": "./types/index.d.ts"
}
